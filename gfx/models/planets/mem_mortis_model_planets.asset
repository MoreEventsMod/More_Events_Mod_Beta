# Wooden Planet
entity = {
	name = "mem_mortis_wooden_planet_entity"
	pdxmesh = "planet_clouded_mesh"
	meshsettings = {
		name = "planet_geosphereShape"
		texture_diffuse = "rooted_01_diffuse.dds"
		texture_normal = "rooted_01_normal.dds"
		texture_specular = "rooted_01_specular.dds"
	}
	##cloud texture override
	meshsettings = {
		name = "clouds_geosphereShape"
		texture_diffuse = "clouds_thin_diffuse.dds"
		texture_normal = "clouds_thin_normal.dds"
		texture_specular = "clouds_thin_specular.dds"
	}
	##cloud shadow texture override
	meshsettings = {
		name = "clouds_shadow_geosphereShape"
		texture_diffuse = "clouds_thin_shadow_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "nospec.dds"
	}
	default_state = "idle"
	state = {
		name = "idle"
		animation = "idle"
		time_offset = {
			0
			100
		}
		start_event = {
			trigger_once = yes
			sound = {
				soundeffect = "amb_planet_world_hive"
			}
		}
		start_event = {
			node = "planet"
			particle = "infested_planet_effect"
			keep_particle = yes
			trigger_once = yes
		}
	}
	#attach = { root = "mem_mortis_01_entity" }
}


entity = {
	name = "mem_ocean_planet_sea_of_conciousness_fog_entity"
	pdxmesh = "planet_clouded_mesh"

	meshsettings = {
		name = "planet_geosphereShape"
		texture_diffuse = "pc_mem_mortis_fog_sea_of_consciousness_diffuse.dds"
		texture_normal = "sea_of_consciousness_normal.dds"
		texture_specular = "sea_of_consciousness_specular.dds"
	}

	##cloud texture override
	meshsettings = {
		name = "clouds_geosphereShape"
		texture_diffuse = "sea_of_consciousness_clouds_diffuse.dds"
		texture_normal = "sea_of_consciousness_clouds_normal.dds"
		texture_specular = "sea_of_consciousness_clouds_specular.dds"
	}

	##cloud shadow texture override
	meshsettings = {
		name = "clouds_shadow_geosphereShape"
		texture_diffuse = "sea_of_consciousness_clouds_shadow_diffuse.dds"
		texture_normal = "nonormal.dds"
		texture_specular = "nospec.dds"
	}

	default_state = "idle"
	state = { name = "idle" animation = "idle" time_offset = { 0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class" } }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_planet_class_02" } }
	}
}