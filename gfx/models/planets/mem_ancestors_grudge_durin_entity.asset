entity = {
	name = "mem_ancestors_grudge_durin_ring_1_entity"
	pdxmesh = "mem_gizmo"
	scale = 1
	attach = { Pivot = "mem_ancestors_grudge_durin_planetary_ring_entity" }
	
	playback_rate = 0.005
	default_state = idle
	state = {
		name = idle
		animation = rotate_x
		time_offset = {	0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_megastructure_orbital_ring_03_idle" } }
	}
}