#mem_asp_site_epilogue
entity = {
	name = "mem_asp_site_epilogue_sphere_entity"
	pdxmesh = "technosphere_mesh"
	
	default_state = "idle"
	state = { name = "idle"		animation = "closed" animation_blend_time = 0 looping = no next_state = "idle"
		start_event = { trigger_once = yes sound = { soundeffect = "technosphere_idle" } }
		chance = {
			if_current_state = {
				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 1
		}
	}

	scale = 0.2
}

entity = {
	name = "mem_asp_site_epilogue_sphere_entity_no_dlc"
	pdxmesh = "locator_mesh"
	
