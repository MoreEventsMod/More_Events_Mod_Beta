				"idle" = 100
				"moving" = 100
				"combat_idle" = 0
				"combat_moving" = 0
			}
			default = 1
		}
	}
	attach = {
		root = "humanoid_01_dyson_sphere_phase_05_entity"
	}

	scale = 0.05
}