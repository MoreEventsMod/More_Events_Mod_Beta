entity = {
	name = "mem_ancestors_grudge_cutholoid_01_entity"
	pdxmesh = "cutholoid_mesh"

	default_state = idle
	# "idle" and "engulf" states are set by code when an engulf type weapon is used
	state = { name = "hidden"				animation = "hidden"			looping = yes
		event = { trigger_once = yes sound = { soundeffect = "amb_astroid_fields" } }
	}
	state = { name = "idle"					animation = "idle"				looping = no	next_state = idle_to_hidden }
	state = { name = "moving"				animation = "moving"			looping = yes
		event = { trigger_once = yes sound = { soundeffect = "ga_cutholoids_idle" } }
	}
	state = { name = "combat_moving"		animation = "attack"			looping = yes 	animation_blend_time = 0.5 }
	state = { name = "engulf"				animation = "attack_engulf"		looping = no	animation_blend_time = 0.1	next_state = combat_moving
		event = { sound = { soundeffect = "ga_cutholoids_engulf" } }
	}

	state = { name = "idle_to_moving"		animation = "hidden_to_idle"	looping = no	next_state = idle_to_moving_next
		event = { sound = { soundeffect = "ga_cutholoids_emerge" } }
	}
	state = { name = "idle_to_moving_next"	animation = "idle_to_moving"	looping = no	next_state = moving }
	state = { name = "moving_to_idle"		animation = "moving_to_idle"	looping = no	next_state = idle }
	state = { name = "idle_to_hidden"		animation = "idle"				looping = no	next_state = idle_to_hidden	chance = 4 }
	state = { name = "idle_to_hidden"		animation = "idle_to_hidden"	looping = no	next_state = hidden			chance = 1
		event = { sound = { soundeffect = "ga_cutholoids_hide" } }
	}

	state = { name = "death" 				animation = "idle"				looping = no
		event = { sound = { soundeffect = "ga_cutholoids_death" } }
	}

	scale = 4

	game_data = {
		dissolve_on_death = 3.0
	}
}




