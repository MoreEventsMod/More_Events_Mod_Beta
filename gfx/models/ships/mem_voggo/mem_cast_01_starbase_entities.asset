entity = {	
	name = "cast_01_starbase_citadel_phase_05_entity"
	pdxmesh = "mem_gizmo"
	scale = 2
	attach = { Pivot = "cast_01_starbase_starport_section_entity" }

	# playback_rate = 0.005
	default_state = idle
	state = {
		name = idle
		animation = rotate_z
		animation_speed = 0.005
		time_offset = {	0 100 }
		start_event = { trigger_once = yes sound = { soundeffect = "amb_megastructure_orbital_ring_03_idle" }   }
	}
}

